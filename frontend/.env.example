# ───────────────────────────────────────────────
# TableWise Frontend – Local Development Env
# ───────────────────────────────────────────────
# Copy this file to frontend/.env and fill in real values.
# Vite only exposes vars prefixed with VITE_

# Base URL of the FastAPI backend (no trailing slash, no /api/v1 suffix).
# The Axios client in src/api/client.ts appends /api/v1 automatically.
VITE_API_BASE_URL=http://localhost:8000

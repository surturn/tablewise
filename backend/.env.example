# ─────────────────────────────────────────────
# TABLEWISE BACKEND — LOCAL DEVELOPMENT ENV
# ─────────────────────────────────────────────
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env — it is gitignored.

# ----------------------
# APP
# ----------------------
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME=TableWise

# ----------------------
# SECURITY
# ----------------------
# Random 32+ byte secret used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme-generate-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ----------------------
# POSTGRES
# ----------------------
# Matches the `db` service in docker-compose.yml when running via Docker.
POSTGRES_USER=tablewise_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tablewise_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tablewise_user:changeme@db:5432/tablewise_db

# ----------------------
# REDIS / CELERY
# ----------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ----------------------
# PAYMENTS (M-Pesa / Safaricom Daraja)
# ----------------------
# Setting MPESA_CONSUMER_KEY=mock_key with ENVIRONMENT=development enables
# mock mode: STK push calls are simulated instead of hitting Safaricom.
MPESA_CONSUMER_KEY=mock_key
MPESA_CONSUMER_SECRET=mock_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=changeme
MPESA_CALLBACK_URL=https://your-ngrok-or-deployed-url/api/v1/payments/mpesa/callback
MPESA_ENV=sandbox

# ----------------------
# AI (Claude)
# ----------------------
ANTHROPIC_API_KEY=sk-ant-changeme

# ----------------------
# EMAIL
# ----------------------
SENDGRID_API_KEY=SG.changeme

# ----------------------
# SMS (Africa's Talking)
# ----------------------
# Set the API key to "mock_key" in development to log SMS instead of sending.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=mock_key
AT_USERNAME=sandbox
AT_API_KEY=mock_key

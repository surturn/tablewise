# ==========================================
# TABLEWISE ENVIRONMENT VARIABLES (TEMPLATE)
# ==========================================

# --- App Settings ---
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME=TableWise

# --- Security ---
# Generate a strong key using: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# --- Database (PostgreSQL) ---
POSTGRES_USER=tablewise_user
POSTGRES_PASSWORD=tablewise_password
POSTGRES_DB=tablewise_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Asyncpg URL format
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Cache & Task Queue (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- M-Pesa (Daraja API) ---
MPESA_ENVIRONMENT=sandbox # sandbox or production
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_SHORTCODE=174379 # Default sandbox shortcode
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/v1/payments/webhook

# --- SMS (Africa's Talking) ---
AT_USERNAME=sandbox
AT_API_KEY=your_at_api_key

# --- AI Intelligence Layer (Anthropic) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
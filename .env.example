# ==========================================
# TABLEWISE ENVIRONMENT VARIABLES (TEMPLATE)
# ==========================================

# --- App Settings ---
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME=TableWise

# --- Security ---
# Generate a strong key using: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# --- Database (PostgreSQL) ---
POSTGRES_USER=tablewise_user
POSTGRES_PASSWORD=tablewise_password
POSTGRES_DB=tablewise_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Asyncpg URL format
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Cache & Task Queue (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Stripe (primary card payments, USD) ---
STRIPE_SECRET_KEY=mock_key
STRIPE_WEBHOOK_SECRET=mock_key
PUBLIC_APP_URL=http://localhost:5173

# --- Mobile Money (fallback/local wallet integrations) ---
MOBILE_MONEY_PROVIDERS=africas_talking,mpesa
MOBILE_MONEY_COLLECTION_URL=
MOBILE_MONEY_CALLBACK_URL=https://your-domain.example/api/v1/payments/mobile-money/webhook
MOBILE_MONEY_API_KEY=mock_key

# --- M-Pesa (legacy Daraja compatibility) ---
MPESA_ENVIRONMENT=sandbox # sandbox or production
MPESA_CONSUMER_KEY=mock_key
MPESA_CONSUMER_SECRET=mock_key
MPESA_PASSKEY=mock_key
MPESA_SHORTCODE=174379 # Default sandbox shortcode
MPESA_CALLBACK_URL=https://your-domain.example/api/v1/payments/webhook

# --- Offline-first POS ---
OFFLINE_ORDER_ID_PREFIX=offline
OFFLINE_SYNC_BATCH_SIZE=100

# --- SMS (Africa's Talking) ---
AT_USERNAME=sandbox
AT_API_KEY=your_at_api_key

# --- AI Intelligence Layer (OpenAI) ---
OPENAI_API_KEY=mock_key